# .env.example — copy to .env and fill in your values
# Do NOT commit .env to Git.
#
# This project uses Vite (not Create React App).
# Use VITE_API_BASE_URL (Vite requires the VITE_ prefix).
# REACT_APP_API_BASE_URL is listed in some assignment templates for CRA projects.

VITE_API_BASE_URL=http://localhost:8000/api

# Optional CRA-style name (also supported in src/api/axios.js):
# REACT_APP_API_BASE_URL=http://localhost:8000/api
